{
	"name": "portfolio",
	"version": "1.0.0",
	"scripts": {
		"ng": "ng",
		"start": "ng serve",
		"build": "ng build",
		"build:stats": "ng build --stats-json",
		"analyze": "ng build --configuration=production --stats-json && npx esbuild-visualizer --metadata=dist/my-angular-app/stats.json --open=true",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"test-coverage": "ng test --coverage --no-watch && open-cli ./coverage/portfolio/index.html",
		"serve:ssr:portfolio": "node dist/portfolio/server/server.mjs",
		"lint": "ng lint",
		"fmt": "npx prettier --use-tabs --tab-width 4 --single-quote --write ."
	},
	"sideEffects": false,
	"prettier": {
		"printWidth": 100,
		"singleQuote": true,
		"useTabs": true,
		"tabWidth": 4,
		"overrides": [
			{
				"files": "*.html",
				"options": {
					"parser": "angular"
				}
			}
		]
	},
	"private": true,
	"packageManager": "npm@11.6.2",
	"dependencies": {
		"@angular/common": "^21.2.4",
		"@angular/compiler": "^21.2.4",
		"@angular/core": "^21.2.4",
		"@angular/forms": "^21.2.4",
		"@angular/platform-browser": "^21.2.4",
		"@angular/platform-server": "^21.2.4",
		"@angular/router": "^21.2.4",
		"@angular/ssr": "^21.2.2",
		"@microsoft/signalr": "^10.0.0",
		"express": "^5.1.0",
		"qrcode": "^1.5.4",
		"rxjs": "~7.8.0",
		"web-vitals": "^5.2.0"
	},
	"devDependencies": {
		"@angular/build": "^21.2.2",
		"@angular/cli": "^21.2.2",
		"@angular/compiler-cli": "^21.2.4",
		"@types/express": "^5.0.1",
		"@types/node": "^20.17.19",
		"@types/qrcode": "^1.5.6",
		"@vitest/coverage-v8": "^4.0.18",
		"angular-eslint": "21.3.0",
		"angular-feather": "^6.5.1",
		"bulma": "^1.0.4",
		"eslint": "^9.39.2",
		"jsdom": "^27.1.0",
		"ngx-markdown": "^21.1.0",
		"open-cli": "^9.0.0",
		"png-to-ico": "^3.0.1",
		"prettier": "^3.8.1",
		"sharp": "^0.34.5",
		"typescript": "~5.9.2",
		"typescript-eslint": "8.50.1",
		"vitest": "^4.0.8",
		"yaml": "^2.8.2"
	}
}
